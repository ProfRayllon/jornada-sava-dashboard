# Copie para .env e preencha localmente. Nunca versione as credenciais.
# Endereços fictícios: substitua antes de publicar.
DOMAIN=example.com

# Senha exclusiva do banco. Prefira caracteres seguros para URL.
# O Compose atual interpola a senha sem codificação automática.
POSTGRES_PASSWORD=

# Primeiro administrador: só será criado se o banco ainda não tiver usuários.
# Não é a senha de uma caixa de e-mail. Alterar aqui não redefine conta existente.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
SESSION_HOURS=8

# Fora do Docker, configure a conexão em .env e execute npm run dev em server/.
# DATABASE_URL=postgresql://sava:SENHA_CODIFICADA_PARA_URL@localhost:5432/jornada_sava
