# Copie para .env e preencha. O .env nunca vai para o Git.

# Domínio do site, sem https:// (o DNS precisa apontar para o IP da VPS).
DOMAIN=jornada.exemplo.com.br

# Senha do PostgreSQL (use algo longo e aleatório).
POSTGRES_PASSWORD=troque-esta-senha

# Administrador criado no primeiro start (só quando o banco ainda não tem usuários).
# O sistema pede para trocar a senha no primeiro acesso.
ADMIN_EMAIL=admin@sava.adv.br
ADMIN_PASSWORD=troque-esta-senha-tambem

# Duração da sessão de login, em horas.
SESSION_HOURS=8

# Desenvolvimento local (fora do Docker): npm run dev, dentro de server/.
# DATABASE_URL=
